# Each driver's physics block (0x563d54, 0x1d0 bytes), in metres and
# seconds: world units * 0.04596; the step is 1/72 s.
struct car_phys 0x1d0 0x563d54
0x000 double mass               0x4923b8 by car
0x008 double inertia            8000.0
0x010 double f010               0.6
0x018 double rear_len           |rear wheel x| * 0.04596 * 1.5
0x020 double front_len          |front wheel x| * 0.04596 * 2
0x028 double heading
0x030 double yaw_rate
0x038 double f038[3]            x * 0.04596
0x050 double f050[3]            z * 0.04596
0x068 double x
0x070 double z
0x078 double vx
0x080 double vz
0x088 double f088
0x090 double f090
0x098 double speed              signed, along the heading
0x0a0 double lateral            the speed across the heading
0x0a8 s32 slipping              the drive passed the traction
0x0ac double steer              the front wheels' angle, radians
0x0b4 double roll               the car's 0x110
0x0bc double pitch              the car's 0x108
0x0c4 double traction           surface, model and difficulty
0x0cc double grip
0x0d4 s32 brake
0x0d8 double drive              the engine's force
0x0e0 double traction_force     traction * the weight on the ground
0x0e8 double grip_force
0x0f0 double corner_x[4]        the body's corners, scaled
0x110 double corner_z[4]
0x130 double f130               4.0
0x138 double corner_world[8]    x, z of each corner
0x178 double corner_scaled[8]   the same, the corners scaled by the speed
0x1b8 double impact             set by the collisions
0x1c0 double contact_x
0x1c8 double contact_z
